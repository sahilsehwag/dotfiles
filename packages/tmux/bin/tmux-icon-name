#!/usr/bin/env bash
# cSpell:words lvim lfcd esac

paneCmd="$1"
panePath="$2"

case $paneCmd in
	tmux)
		echo ""
		;;
	fish | zsh | bash)
		echo "$(basename "$panePath")"
		;;
	nvim | vim | lvim)
		echo " $(basename $panePath)"
		;;
	lf | lfcd | ranger | vifm)
		echo " $(basename "$panePath")"
		;;
	lazygit | git)
		repoRoot=$(git -C "$panePath" rev-parse --show-toplevel 2>/dev/null || echo "$panePath")
		echo "󰊢 $(basename "$repoRoot")"
		;;
	node)
		echo ""
		;;
	ruby)
		echo ""
		;;
	go)
		echo "ﳑ"
		;;
	*)
		echo $paneCmd
		;;
esac
